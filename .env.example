# ─── BloomBot RAG Chatbot API Keys ─────────────────────────────────────────
# Only ONE key is needed — Gemini API Key
# Get it free at: https://aistudio.google.com → "Get API Key"

GEMINI_API_KEY=your_gemini_api_key_here


# In your project directory (where rag_chat.py lives, or one level up)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── Optional: Google Custom Search (NOT required) ──────────────────────────
# The chatbot uses DuckDuckGo by default (free, no key needed).
# Uncomment below only if you want to switch to Google Search later.
# GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_CSE_ID=your_search_engine_id_here
